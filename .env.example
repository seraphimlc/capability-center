# 复制为 .env 后按需填写。docker compose 已内置本地默认值，不填也能启动。
# 不要把真实 AK/SK 提交到仓库。

APP_ENV=local
JWT_SECRET=change-me-in-production
API_KEY_PEPPER=change-me-pepper
COOKIE_SECURE=false

# MySQL / Redis（compose 内已覆盖）
DATABASE_URL=mysql://cc:cc_pass_local@127.0.0.1:13306/capability_center
REDIS_URL=redis://127.0.0.1:16379

# 模型网关。不设置 LLM_API_KEY / XY_API_KEY 时自动走本地 mock SSE。
# 密钥只写在这个文件（或本机环境），不要写进仓库、override 或文档。
# Docker Desktop for Mac 容器直连网关会 TLS 失败时：先跑
#   node scripts/xy-llm-proxy.mjs
# 再把 docker-compose.override.yml.example 复制为 docker-compose.override.yml。
# LLM_PROVIDER=auto|xy|chathub|mock
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.xytoken.xyb2b.com/v1
XY_BASE_URL=https://api.xytoken.xyb2b.com/v1
LLM_API_KEY=
XY_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# 临时备用：ChatHub（OpenAI 兼容）。与 XY 分开配置，默认不启用。
CHATHUB_BASE_URL=
CHATHUB_API_KEY=
CHATHUB_MODEL=

# 对象存储。本地 compose 使用 MinIO。生产改为 aliyun，不要复用其他产品前缀。
# OSS_PROVIDER=minio|aliyun|mock
OSS_PROVIDER=minio
OSS_ENDPOINT=http://127.0.0.1:9000
# 浏览器直传要和页面同源。Compose 里经用户端 Nginx 转到 MinIO，因此是 http://localhost:8888
OSS_PUBLIC_ENDPOINT=http://127.0.0.1:9000
OSS_REGION=us-east-1
OSS_BUCKET=capability-center
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=capability-center
MEDIA_PUBLIC_BASE=
OSS_SIGNED_URL_EXPIRES=3600
OSS_PUBLIC_READ=false
OSS_FORCE_PATH_STYLE=true

# 演示账号（仅本地种子，生产务必修改）
SEED_ADMIN_EMAIL=admin@visitworlds.me
SEED_ADMIN_PASSWORD=Admin123456
SEED_OPS_EMAIL=ops@visitworlds.me
SEED_OPS_PASSWORD=Ops123456
SEED_DEMO_EMAIL=demo@visitworlds.me
SEED_DEMO_PASSWORD=Demo123456
SEED_API_KEY=ck_sandbox_demo01_capabilitycenterdevsecret

# LinkFox / 上游商业连接器（勿提交真实密钥）
LINKFOX_API_KEY=
LINKFOXAGENT_API_KEY=

# 商标 MCP（平台级试点账号，OAuth token）。不要提交真实 token。
# 首次授权后把 access/refresh token 和 client_id 填在这里；API 会在 401 时自动刷新。
TRADEMARK_MCP_URL=https://ipunique.com/mcp
TRADEMARK_MCP_TOKEN_URL=https://ipunique.com/api/oauth/token
TRADEMARK_MCP_RESOURCE=https://ipunique.com/mcp
TRADEMARK_MCP_CLIENT_ID=
TRADEMARK_MCP_TOKEN=
TRADEMARK_MCP_REFRESH_TOKEN=
# 重新授权后需要让 .env 覆盖数据库里的旧 token 时，临时设为 1 重启 api
TRADEMARK_MCP_FORCE=
